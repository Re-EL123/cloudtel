{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/v1/**/*.js": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/auth",
      "destination": "/api/v1/auth/[[...path]]"
    },
    {
      "source": "/api/v1/users",
      "destination": "/api/v1/users/[[...path]]"
    },
    {
      "source": "/api/v1/organisations",
      "destination": "/api/v1/organisations/[[...path]]"
    },
    {
      "source": "/api/v1/extensions",
      "destination": "/api/v1/extensions/[[...path]]"
    },
    {
      "source": "/api/v1/contacts",
      "destination": "/api/v1/contacts/[[...path]]"
    },
    {
      "source": "/api/v1/calls",
      "destination": "/api/v1/calls/[[...path]]"
    },
    {
      "source": "/api/v1/call-control",
      "destination": "/api/v1/call-control/[[...path]]"
    },
    {
      "source": "/api/v1/settings",
      "destination": "/api/v1/settings/[[...path]]"
    },
    {
      "source": "/api/v1/admin",
      "destination": "/api/v1/admin/[[...path]]"
    },
    {
      "source": "/api/v1/webhooks",
      "destination": "/api/v1/webhooks/[[...path]]"
    },
    {
      "source": "/api/v1/billing",
      "destination": "/api/v1/billing/[[...path]]"
    },
    {
      "source": "/api/v1/health",
      "destination": "/api/v1/health/[[...path]]"
    }
  ]
}
