# CloudTel - environment template.
# Copy to .env for local development. NEVER commit real credentials.

# Application
NODE_ENV=development
APP_NAME=CloudTel
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
DEFAULT_TIMEZONE=Africa/Johannesburg

# Comma-separated list of browser origins allowed to call the API with
# credentials (cookies). Include every host that serves the frontend.
# e.g. https://cloudtel.re-el.co.za,https://app.cloudtel.example,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/cloudtel

# Authentication
SESSION_SECRET=change-me-to-a-long-random-string
PASSWORD_RESET_SECRET=change-me-to-a-different-long-random-string
SESSION_TTL_HOURS=12
# Lax for same-site deployments; None (with Secure) when the frontend is on a
# different site than the API (e.g. GitHub Pages -> *.vercel.app).
SESSION_COOKIE_SAMESITE=Lax

# Telephony management (server-side only - never exposed to the browser)
PBX_API_BASE_URL=
PBX_API_USERNAME=
PBX_API_PASSWORD=

# SIP configuration (public identifiers only - no passwords)
SIP_DOMAIN=
SIP_WSS_URL=wss://pbx.example.com:8089/ws
SIP_TRANSPORT=WSS
SIP_VOICEMAIL_CODE=*97

# Webhook verification
TELEPHONY_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=

# Rate limiting (optional shared store; in-database counters used by default)
RATE_LIMIT_STORE_URL=

# Billing (leave empty until commercial launch)
BILLING_PROVIDER=
BILLING_SECRET_KEY=

# Observability
LOG_LEVEL=info
