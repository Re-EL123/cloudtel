# Asterisk ARI connection
ARI_URL=http://127.0.0.1:8088
ARI_USERNAME=cloudtel
ARI_PASSWORD=change-me

# Stasis application that owns CloudTel extensions
ARI_STASIS_APP=cloudtel

# CloudTel webhook endpoint and shared HMAC secret
CLOUDTEL_WEBHOOK_URL=https://api.cloudtel.example/api/v1/webhooks/telephony
TELEPHONY_WEBHOOK_SECRET=change-me-too

# Optional: pin every event to a single tenant
# CLOUDTEL_ORGANISATION_ID=

# Optional delivery tuning
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5
RECORDING_BASE_URL=https://cdn.cloudtel.example/recordings
