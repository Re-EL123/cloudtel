# PBX admin API (Asterisk)
PORT=8090
BIND_ADDRESS=127.0.0.1

# Asterisk ARI (same host)
ARI_URL=http://127.0.0.1:8088
ARI_USERNAME=cloudtel
ARI_PASSWORD=change-me

# Basic auth used by the CloudTel API (PBX_API_USERNAME / PBX_API_PASSWORD)
PBX_API_USERNAME=cloudtel
PBX_API_PASSWORD=change-me-too

# Generated PJSIP include (included by pjsip.conf)
PJSIP_INCLUDE_DIR=/etc/asterisk/pjsip.d
PJSIP_INCLUDE_FILE=cloudtel.conf
PJSIP_CONTEXT=cloudtel-internal

# Persisted extension state
STATE_FILE=/var/lib/cloudtel-pbx/extensions.json

# Public SIP domain (informational)
SIP_DOMAIN=
